# -----------------------------------------------------------------------------
# Site deployment configuration
# Copy to .env.local (or set in your hosting provider) per deployment target.
# -----------------------------------------------------------------------------

# Canonical public domain WITHOUT protocol or trailing slash.
# Drives canonical URLs, hreflang, Open Graph and JSON-LD via src/lib/site.ts.
# NEXT_PUBLIC_ prefix is required so the value is inlined into both the server
# and client bundles at build time.
NEXT_PUBLIC_SITE_DOMAIN=johnogroatssignpost.com
